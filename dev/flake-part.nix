# Development shell: the formatter the repo is checked with, so a contribution
# and CI agree on what formatted Nix looks like.
{ inputs, ... }:
{
  imports = [ inputs.treefmt-nix.flakeModule ];

  perSystem =
    { pkgs, config, ... }:
    {
      treefmt = {
        # Nix only for now — add a formatter here when the repo grows files that
        # need one.
        programs.nixfmt.enable = true;
        # Generated by nix build / nix flake check, never committed.
        settings.excludes = [
          "result"
          "result-*"
          ".direnv"
        ];
      };

      devShells.default = pkgs.mkShell {
        packages = with pkgs; [
          git
          gh
          nix-tree
        ];
        inputsFrom = [ config.treefmt.build.devShell ];

        shellHook = ''
          echo '  treefmt .            format every file'
          echo '  treefmt --fail-on-change .   what the treefmt check runs'
          echo '  nix flake check      eval tests and the example build'
        '';
      };
    };
}
